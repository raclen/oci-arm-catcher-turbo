# ==============================================================================
# Oracle Cloud Infrastructure (OCI) ARM Catcher Configuration Template
# ==============================================================================

# 租户 / 区间 OCID (Tenancy or Compartment OCID)
COMPARTMENT_ID="ocid1.tenancy.oc1..your_tenancy_ocid"

# 子网 OCID (Subnet OCID)
SUBNET_ID="ocid1.subnet.oc1.your_region.your_subnet_ocid"

# 基础系统映像 OCID (Ubuntu / Oracle Linux ARM Image OCID)
IMAGE_ID="ocid1.image.oc1.your_region.your_image_ocid"

# 抢到的实例名称
INSTANCE_NAME="arm-1c6g"

# 准备注入到新 ARM 机器的 SSH 公钥文件绝对路径 (Public Key ONLY, not private key!)
SSH_KEY_FILE="/home/ubuntu/.ssh/oracle_arm.pub"

# 抢机规格配置 (Flex Shape Config)
# Always Free 额度上限为 4 OCPU / 24 GB 内存
OCPUS="1"
MEMORY_GB="6"

# 抢机重试随机时间间隔 (秒)
RETRY_MIN="60"
RETRY_MAX="120"

# OCI CLI 输出抑制警告
SUPPRESS_LABEL_WARNING="True"

# [可选] 微信推送通知 - Server酱 SendKey (留空则不推送)
# 获取地址: https://sct.ftqq.com/
SERVERCHAN_SENDKEY="SCTxxxxxxxxxxxxxxxxxxxxxxx"
